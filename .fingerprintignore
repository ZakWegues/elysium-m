# Saídas de build do módulo nativo local (20/10): o Gradle cria estas pastas no meio da build,
# e o fingerprint calculado pelo expo-updates durante a build pegava a pasta pela metade — o APK
# saía com um runtime que ninguém mais reproduzia, e OTA nenhum chegaria nele.
modules/*/android/build/**/*
modules/*/android/.gradle/**/*
modules/*/android/.cxx/**/*
# 31/10 (APK 2.6.0): o mesmo problema no plugin Gradle do expo-updates — o daemon do Kotlin cria
# um arquivo de sessão em .kotlin/ só enquanto compila, e o fingerprint da build pegava ele.
**/.kotlin/**/*
node_modules/expo-updates/expo-updates-gradle-plugin/build/**/*
node_modules/expo-updates/expo-updates-gradle-plugin/.gradle/**/*
