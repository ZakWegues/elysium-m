{
  "expo": {
    "name": "ELYSIUM-M",
    "slug": "neuroaxis-portal",
    "scheme": "elysium",
    "version": "2.11.0",
    "orientation": "portrait",
    "updates": {
      "url": "https://u.expo.dev/a9c62871-2d6d-4e05-b458-1e58655449b5",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zak.elysium.m",
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos da câmera pra escanear o QR code de pareamento e pra fotografar e perguntar ao ELYSIUM.",
        "NSMicrophoneUsageDescription": "Precisamos do microfone pra você falar com o ELYSIUM.",
        "NSFaceIDUsageDescription": "Confirmamos sua identidade antes de ações que mexem no PC, como desligar ou encerrar programas."
      }
    },
    "android": {
      "package": "com.zak.elysium.m",
      "versionCode": 33,
      "adaptiveIcon": {
        "backgroundColor": "#0a0c14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "elysium"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos da câmera pra escanear o QR code de pareamento e pra fotografar e perguntar ao ELYSIUM."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundRecording": true
        }
      ],
      "expo-notifications",
      "expo-local-authentication",
      "./plugins/withReleaseSigning",
      "./plugins/withGradleMemory",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-background-task",
      [
        "react-native-android-widget",
        {
          "fonts": [],
          "widgets": [
            {
              "name": "Esfera",
              "label": "ELYSIUM — Ely",
              "description": "Falar com a Ely, buscar ou abrir o chat. Muda com o tamanho: esfera, barra 4×1 ou painel.",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "Estado",
              "label": "ELYSIUM — PC",
              "description": "PC ligado ou não, CPU e RAM; maior, ganha bloquear, print, play e mudo.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Hoje",
              "label": "ELYSIUM — Hoje",
              "description": "Saudação, tarefas e hábitos do dia; toque conclui e marca.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Clima",
              "label": "ELYSIUM — Clima",
              "description": "O tempo agora e nas próximas horas.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Musica",
              "label": "ELYSIUM — Música",
              "description": "O que toca no PC e os botões de mídia.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Foco",
              "label": "ELYSIUM — Tempo",
              "description": "Modo foco e timers, sem abrir o app.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Listas",
              "label": "ELYSIUM — Listas",
              "description": "Os pendentes da lista; toque marca como feito.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Rotinas",
              "label": "ELYSIUM — Rotinas",
              "description": "A próxima rotina e o resultado da última.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-quick-actions",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O ELYSIUM usa o microfone para ouvir o seu pedido quando você diz “Ely” ou segura o botão de falar.",
          "speechRecognitionPermission": "O ELYSIUM reconhece a palavra “Ely” com o app aberto.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0c14",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0a0c14"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "disableIOS": true
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "a9c62871-2d6d-4e05-b458-1e58655449b5"
      }
    },
    "owner": "zakdwr"
  }
}
