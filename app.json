{
  "expo": {
    "name": "ELYSIUM-M",
    "slug": "neuroaxis-portal",
    "scheme": "elysium",
    "version": "2.6.0",
    "orientation": "portrait",
    "updates": {
      "url": "https://u.expo.dev/a9c62871-2d6d-4e05-b458-1e58655449b5",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zak.elysium.m",
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos da câmera pra escanear o QR code de pareamento e pra fotografar e perguntar ao ELYSIUM.",
        "NSMicrophoneUsageDescription": "Precisamos do microfone pra você falar com o ELYSIUM.",
        "NSFaceIDUsageDescription": "Confirmamos sua identidade antes de ações que mexem no PC, como desligar ou encerrar programas."
      }
    },
    "android": {
      "package": "com.zak.elysium.m",
      "versionCode": 26,
      "adaptiveIcon": {
        "backgroundColor": "#0a0c14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "elysium"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos da câmera pra escanear o QR code de pareamento e pra fotografar e perguntar ao ELYSIUM."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundRecording": true
        }
      ],
      "expo-notifications",
      "expo-local-authentication",
      "./plugins/withReleaseSigning",
      "./plugins/withGradleMemory",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
